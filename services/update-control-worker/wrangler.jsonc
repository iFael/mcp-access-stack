{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcp-v3-update-control",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "UPDATE_CONTROL_AUTH_STATE",
        "class_name": "UpdateControlAuthState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UpdateControlAuthState"]
    }
  ]
}
