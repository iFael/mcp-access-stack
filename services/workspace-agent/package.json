{
  "name": "@vs-code-gpt/local-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vs-code-gpt-agent": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "npm run build --workspace @mcp-access-stack/update-control-contract",
    "build": "tsc -p tsconfig.json",
    "test": "node ../../tooling/testing/run-jest.mjs --config jest.config.ts --runInBand",
    "test:unit": "node ../../tooling/testing/run-jest.mjs --config jest.config.ts --runInBand --selectProjects workspace-agent-unit",
    "test:integration": "node ../../tooling/testing/run-jest.mjs --config jest.config.ts --runInBand --selectProjects workspace-agent-integration",
    "test:watch": "node ../../tooling/testing/run-jest.mjs --config jest.config.ts --watch",
    "test:coverage": "node ../../tooling/testing/run-jest.mjs --config jest.config.ts --runInBand --coverage"
  },
  "dependencies": {
    "@ast-grep/cli": "^0.51.0",
    "@mcp-access-stack/update-control-contract": "0.1.0",
    "@vs-code-gpt/shared": "0.1.0",
    "iconv-lite": "^0.7.3",
    "minimatch": "^10.2.0"
  }
}
