# Edge Connector runtime example
# Secrets are placeholders only. Do not commit a populated copy.

# Public Cloudflare Worker origin. Must be HTTPS and contain no path/query.
MCP_EDGE_BASE_URL=https://mcp-access-stack.example.workers.dev

# Absolute path to a local file containing only the connector Bearer token.
MCP_CONNECTOR_TOKEN_FILE=<ABSOLUTE_CONNECTOR_TOKEN_FILE>

# Existing workspace policy consumed directly by LocalAgent.
VS_CODE_GPT_POLICY_PATH=<ABSOLUTE_WORKSPACE_POLICY_FILE>

# Optional connector-side concurrency cap. Default: 8.
MCP_CONNECTOR_MAX_CONCURRENT_REQUESTS=8

# The embedded Gateway preserves the existing authentication model.
AUTH_MODE=owner
OWNER_TOKEN=<OWNER_TOKEN_WITH_AT_LEAST_16_CHARACTERS>
OWNER_OAUTH_SCOPES=workspaces:read
# Optional durable Owner OAuth state. Use a private local path; bearer tokens are stored only as SHA-256 hashes.
OWNER_OAUTH_STATE_PATH=<ABSOLUTE_PRIVATE_OWNER_OAUTH_STATE_FILE>
ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com

# Browser integration is explicit and loopback-only. Production task installation injects the token from a private file; do not place a real token in this file.
# BROWSER_WORKER_ENABLED=true
# BROWSER_WORKER_URL=http://127.0.0.1:3350
# BROWSER_WORKER_TOKEN=<BROWSER_WORKER_TOKEN_PLACEHOLDER>
