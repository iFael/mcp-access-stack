# Modo de autenticacao: "oauth" (IdP externo), "owner" (senha Owner estilo DevSpace) ou "none" (uso pessoal via tunel).
AUTH_MODE=oauth
PORT=3000
PUBLIC_BASE_URL=https://mcp.example.com
# Caminho do endpoint MCP. Use um segmento secreto (ex.: /mcp-a8f3k2x9) no modo none.
MCP_PATH=/mcp
# Quantos proxies reversos confiar para o IP do cliente. 0 = nenhum; 1 = um proxy/tunel.
TRUST_PROXY=0
# Variaveis OAUTH_* sao obrigatorias somente quando AUTH_MODE=oauth.
OAUTH_ISSUER=https://tenant.example.com/
OAUTH_AUDIENCE=https://mcp.example.com
OAUTH_JWKS_URL=https://tenant.example.com/.well-known/jwks.json
OAUTH_ALLOWED_SUBJECTS=user-id
OAUTH_REQUIRED_SCOPE=workspaces:read
# Variaveis OWNER_* sao obrigatorias somente quando AUTH_MODE=owner.
# OWNER_TOKEN=minimo-16-caracteres-aleatorios
# OWNER_OAUTH_SCOPES=workspaces:read
ALLOWED_ORIGINS=https://chatgpt.com
AGENT_ID=local-agent
AGENT_TOKEN_SHA256=replace-with-a-sha256-hex-digest
# Maximos permitidos: 300000 ms, 4 chamadas concorrentes e 536870912 bytes (512 MiB).
AGENT_REQUEST_TIMEOUT_MS=60000
AGENT_HEARTBEAT_MS=30000
AGENT_MAX_CONCURRENCY=4
AGENT_MAX_PAYLOAD_BYTES=536870912
# Fachada REST privada para GPT Actions. O token em texto puro fica somente no editor do GPT.
GPT_ACTIONS_ENABLED=false
GPT_ACTIONS_TOKEN_SHA256=<64_HEX_CHARACTERS>
GPT_ACTIONS_WORKSPACE_IDS=workspace-a
GPT_ACTIONS_ALLOW_WRITE=false
GPT_ACTIONS_ALLOW_SHELL=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
LOG_LEVEL=info
