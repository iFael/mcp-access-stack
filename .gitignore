# Private/local runtime state
**/.runtime-private/
**/.runtime-tools/
**/runtime/
**/.codex/
**/.env
**/.env.*
!**/.env.example
!**/.env*.example
**/config/workspace-policy.local.json
**/.cursor/
**/.vscode/settings.json

# Dependencies and build output
**/node_modules/
**/dist/
**/dist-ui/
**/coverage/
**/.cache/
**/*.tsbuildinfo

# Immutable releases are local; retain only explicit placeholders
**/releases/*
!**/releases/.gitkeep

# Logs and temporary files
**/*.log
**/*.tmp
**/stack-runtime.json
**/proxy-routes.json

# OS/editor noise
.DS_Store
Thumbs.db
