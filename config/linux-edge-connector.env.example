# Linux Edge Connector runtime example.
# This file contains paths/configuration only. Keep real tokens in separate mode-0600 files.

VS_CODE_GPT_STACK_ROOT=/srv/mcp-access-stack
MCP_ACCESS_STACK_RUNTIME_ROOT=/var/lib/mcp-access-stack/edge-connector
MCP_ACCESS_STACK_INSTALLATION_ROOT=/var/lib/mcp-access-stack

MCP_EDGE_BASE_URL=https://mcp-access-stack.example.workers.dev
MCP_CONNECTOR_TOKEN_FILE=/etc/mcp-access-stack/secrets/connector-token
MCP_OWNER_TOKEN_FILE=/etc/mcp-access-stack/secrets/owner-token
VS_CODE_GPT_POLICY_PATH=/etc/mcp-access-stack/workspace-policy.json

# Node 26+ is required. Prefer an explicit immutable path in production.
MCP_NODE_BINARY=/usr/local/bin/node

MCP_CONNECTOR_MAX_CONCURRENT_REQUESTS=8
MCP_SESSION_MODE=stateless
OWNER_OAUTH_SCOPES=workspaces:read
ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
