NODE_ENV=production
PORT=3310
PUBLIC_BASE_URL=https://mcp.example.ngrok.app
AUTH_MODE=owner
OWNER_TOKEN=<OWNER_TOKEN_WITH_AT_LEAST_16_CHARACTERS>
OWNER_OAUTH_SCOPES=workspaces:read
MCP_PATH=/mcp-production
TRUST_PROXY=1
ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
AGENT_ID=gpt-only-production-agent
AGENT_TOKEN_SHA256=<64_HEX_CHARACTERS>
AGENT_REQUEST_TIMEOUT_MS=60000
AGENT_HEARTBEAT_MS=30000
AGENT_MAX_CONCURRENCY=4
AGENT_MAX_PAYLOAD_BYTES=536870912
BROWSER_WORKER_ENABLED=true
BROWSER_WORKER_ALLOW_DOCKER_HOST=true
BROWSER_WORKER_URL=http://host.docker.internal:3350
BROWSER_WORKER_TOKEN=<BROWSER_WORKER_TOKEN>
BROWSER_WORKER_TIMEOUT_MS=120000
BROWSER_WORKER_MAX_PAYLOAD_BYTES=4194304
GPT_ACTIONS_ENABLED=true
GPT_ACTIONS_TOKEN_SHA256=<64_HEX_CHARACTERS>
GPT_ACTIONS_WORKSPACE_IDS=workspace-a
GPT_ACTIONS_ALLOW_WRITE=true
GPT_ACTIONS_ALLOW_SHELL=true
LOG_LEVEL=info
