NODE_ENV=development
PORT=4310
PUBLIC_BASE_URL=http://127.0.0.1:4300
AUTH_MODE=none
MCP_PATH=/mcp-development
TRUST_PROXY=0
ALLOWED_ORIGINS=http://127.0.0.1
AGENT_ID=gpt-only-docker-development-agent
AGENT_TOKEN_SHA256=<64_HEX_CHARACTERS>
AGENT_REQUEST_TIMEOUT_MS=60000
AGENT_HEARTBEAT_MS=30000
AGENT_MAX_CONCURRENCY=4
AGENT_MAX_PAYLOAD_BYTES=536870912
BROWSER_WORKER_ENABLED=false
BROWSER_WORKER_ALLOW_DOCKER_HOST=false
BROWSER_WORKER_URL=http://host.docker.internal:4350
GPT_ACTIONS_ENABLED=false
GPT_ACTIONS_TOKEN_SHA256=<64_HEX_CHARACTERS>
GPT_ACTIONS_WORKSPACE_IDS=workspace-a
GPT_ACTIONS_ALLOW_WRITE=false
GPT_ACTIONS_ALLOW_SHELL=false
LOG_LEVEL=info
