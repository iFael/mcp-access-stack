[Unit]
Description=MCP Access Stack Edge Connector
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=6

[Service]
Type=simple
WorkingDirectory=/srv/mcp-access-stack
EnvironmentFile=%h/edge-connector.env
ExecStart=%h/current/deploy/linux/Start-McpEdgeConnector.sh --from-environment
Restart=always
RestartSec=2s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
